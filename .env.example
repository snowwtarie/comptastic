# Used by `docker compose` (docker-compose.yml / compose.yaml) for the
# self-hosted deployment. Copy to .env, fill in the values, then:
#   docker compose up -d --build
#
# This is separate from apps/api/.env and apps/web/.env, which are for
# local development only and are not used by the containers.

# Generate once with: docker compose run --rm api php artisan key:generate --show
APP_KEY=

DB_DATABASE=comptastic
DB_USERNAME=comptastic
DB_PASSWORD=

# Public URLs the app is actually reachable at. If you're running this
# behind a reverse proxy with TLS, these should be the https:// URLs
# collaborators/users hit — not the container-internal addresses.
API_URL=http://localhost:8000
WEB_URL=http://localhost:8080

# Host ports to publish. Change if 8000/8080 are already taken.
API_PORT=8000
WEB_PORT=8080

# Sanctum/session config — must match the host:port of WEB_URL above
# (no scheme, no trailing slash) or cross-origin auth will silently fail.
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:8080
